#!/usr/bin/env ruby
# open-wrapper

# 20241110
# 0.1.2

# Description: A wrapper for macOS' open command so as to extend it with shortcuts.

# Notes:
# 1. It is intended that this be aliased to `open`.

# Changes:
# Enable a single command to be able to open multiple entries.
# ---
# 1. /open_string()/open_strings()/
# 2. ~ main(), so that it loops over what is returned from open_strings().
# 0/1
# 3. ~ open_strings(), so that it doesn't run the value, but merely returns the string therein.
# 1/2
# 4. ~ main(): assign the command to a variable first before using, to assist with debugging.

CONFIG_FILENAME = '~/.config/open-wrapper/config.rb'

def config_filename
  File.expand_path(CONFIG_FILENAME)
end

def config_file
  File.read(config_filename)
end

def config
  instance_eval(config_file)
end

def labels
  config.keys
end

def open_strings
  argument_string = ARGV.join
  if labels.include?(argument_string)
    label = argument_string
    if config[label].is_a?(String)
      config[label]
    else
      config[label].call
    end
  else
    argument_string
  end
end

def main
  [open_strings].flatten.each_with_index do |open_string, i|
    command = "open #{open_string}"
    system(command)
  end
end

main
